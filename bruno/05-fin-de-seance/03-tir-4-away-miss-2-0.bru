meta {
  name: Tir 4 - AWAY MISS, 2-0
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/shootouts/{{shootoutId}}/shots
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "team": "AWAY",
    "shooter": "Griezmann",
    "goalkeeper": "Donnarumma",
    "outcome": "MISS",
    "clientShotId": "shot-4",
    "expectedVersion": 3
  }
}

assert {
  res.status: eq 201
  res.body.status: eq IN_PROGRESS
  res.body.score.home: eq 2
  res.body.score.away: eq 0
  res.body.nextTeam: eq HOME
  res.body.winner: isNull
  res.body.version: eq 4
  res.body.shots: length 4
}

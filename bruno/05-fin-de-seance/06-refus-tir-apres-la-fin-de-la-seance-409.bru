meta {
  name: Refus - tir après la fin de la séance (409)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/shootouts/{{shootoutId}}/shots
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "team": "HOME",
    "shooter": "Griezmann",
    "goalkeeper": "Donnarumma",
    "outcome": "GOAL",
    "clientShotId": "shot-7",
    "expectedVersion": 6
  }
}

assert {
  res.status: eq 409
  res.body.error.code: eq SHOOTOUT_FINISHED
  res.body.error.message: isString
}

meta {
  name: Tir 6 - AWAY sur le poteau, 3-0 : écart impossible à combler, HOME gagne
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/shootouts/{{shootoutId}}/shots
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "team": "AWAY",
    "shooter": "Griezmann",
    "goalkeeper": "Donnarumma",
    "outcome": "POST",
    "clientShotId": "shot-6",
    "expectedVersion": 5
  }
}

assert {
  res.status: eq 201
  res.body.status: eq FINISHED
  res.body.score.home: eq 3
  res.body.score.away: eq 0
  res.body.nextTeam: isNull
  res.body.winner: eq HOME
  res.body.version: eq 6
  res.body.shots: length 6
}

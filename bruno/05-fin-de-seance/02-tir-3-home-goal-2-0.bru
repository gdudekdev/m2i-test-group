meta {
  name: Tir 3 - HOME GOAL, 2-0
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/shootouts/{{shootoutId}}/shots
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "team": "HOME",
    "shooter": "Griezmann",
    "goalkeeper": "Donnarumma",
    "outcome": "GOAL",
    "clientShotId": "shot-3",
    "expectedVersion": 2
  }
}

assert {
  res.status: eq 201
  res.body.status: eq IN_PROGRESS
  res.body.score.home: eq 2
  res.body.score.away: eq 0
  res.body.nextTeam: eq AWAY
  res.body.winner: isNull
  res.body.version: eq 3
  res.body.shots: length 3
}

meta {
  name: Tir 1 - HOME marque, 1-0 (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/shootouts/{{shootoutId}}/shots
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "team": "HOME",
    "shooter": "Griezmann",
    "goalkeeper": "Donnarumma",
    "outcome": "GOAL",
    "clientShotId": "shot-1",
    "expectedVersion": 0
  }
}

assert {
  res.status: eq 201
  res.body.status: eq IN_PROGRESS
  res.body.score.home: eq 1
  res.body.score.away: eq 0
  res.body.nextTeam: eq AWAY
  res.body.winner: isNull
  res.body.version: eq 1
  res.body.shots: length 1
  res.body.shots[0].sequence: eq 1
  res.body.shots[0].clientShotId: eq shot-1
  res.body.shots[0].recordedAt: isString
}
